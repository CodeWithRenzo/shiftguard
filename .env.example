# ShiftGuard configuration reference
# This file is a TEMPLATE. The real configuration lives in app/config.php.
# Do not commit real secrets anywhere.

APP_URL=https://shift.example.com
APP_ENV=production

DB_DSN=mysql:host=localhost;dbname=shiftguard;charset=utf8mb4
DB_USER=shiftguard
DB_PASS=changeme

# Generate with: php -r "echo bin2hex(random_bytes(32));"
TOKEN_PEPPER=

# Generate with: php -r "echo bin2hex(random_bytes(24));"
CRON_TOKEN=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=no-reply@shift.example.com
SMTP_FROM_NAME=ShiftGuard

# Web Push (VAPID) — generate keys with the artisan command in the README
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shift.example.com